{% doc %}
  @prompt
    Make the product page more visually engaging and interactive. Add a bold high-contrast color scheme with a dark background (deep black or navy) and vibrant accent colors (yellow or orange) matching CrackIt branding. Make headings bold and prominent. Add animated hover effects on Add to Cart and Buy Now buttons, a glow effect on key selling points, and smooth section transitions. Modern, energetic, and conversion-focused for a student audience.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-conversion-panel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.panel_padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    box-shadow: 0 0 28px {{ block.settings.accent_color | color_modify: 'alpha', 0.18 }};
  }

  .ai-conversion-panel-{{ ai_gen_id }}__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(26px, 4vw, 42px);
    line-height: 1.05;
    font-weight: 900;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__text {
    margin: 12px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.55;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 22px 0;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__point {
    padding: 14px 12px;
    background: {{ block.settings.point_background }};
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: {{ block.settings.corner_radius | divided_by: 2 }}px;
    color: {{ block.settings.point_text_color }};
    font-size: 14px;
    font-weight: 800;
    line-height: 1.3;
    box-shadow: 0 0 16px {{ block.settings.accent_color | color_modify: 'alpha', 0.22 }};
  }

  .ai-conversion-panel-{{ ai_gen_id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 12px 22px;
    border: 2px solid {{ block.settings.accent_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__button:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 22px {{ block.settings.accent_color | color_modify: 'alpha', 0.55 }};
  }

  .ai-conversion-panel-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-conversion-panel-{{ ai_gen_id }}__button--primary {
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.accent_text_color }};
  }

  .ai-conversion-panel-{{ ai_gen_id }}__button--secondary {
    background: transparent;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-conversion-panel-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-conversion-panel-{{ ai_gen_id }}__points {
      grid-template-columns: 1fr;
    }

    .ai-conversion-panel-{{ ai_gen_id }}__button {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-conversion-panel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-conversion-panel-{{ ai_gen_id }}__inner">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-conversion-panel-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2 class="ai-conversion-panel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% if block.settings.description != blank %}
      <div class="ai-conversion-panel-{{ ai_gen_id }}__text">{{ block.settings.description }}</div>
    {% endif %}

    <div class="ai-conversion-panel-{{ ai_gen_id }}__points" role="list">
      {% for i in (1..3) %}
        {% assign point_key = 'point_' | append: i %}
        {% if block.settings[point_key] != blank %}
          <div class="ai-conversion-panel-{{ ai_gen_id }}__point" role="listitem">{{ block.settings[point_key] | escape }}</div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-conversion-panel-{{ ai_gen_id }}__actions">
      {% if product != blank %}
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="ai-conversion-panel-{{ ai_gen_id }}__button ai-conversion-panel-{{ ai_gen_id }}__button--primary" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}{{ block.settings.add_label | escape }}{% else %}{{ block.settings.sold_out_label | escape }}{% endif %}
          </button>
        {% endform %}
      {% endif %}
      {% if block.settings.secondary_link != blank %}
        <a href="{{ block.settings.secondary_link }}" class="ai-conversion-panel-{{ ai_gen_id }}__button ai-conversion-panel-{{ ai_gen_id }}__button--secondary">{{ block.settings.secondary_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Conversion boost panel",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to stand out" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to level up?" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Bold design, sharp details, and everyday performance built for your next move.</p>" },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Student-ready style" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Fast, reliable delivery" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Easy returns" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold-out button", "default": "Sold out" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "See details" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "panel_padding", "label": "Panel padding", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 6 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#07111F" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F3F4F6" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#FFB000" },
    { "type": "color", "id": "accent_text_color", "label": "Accent text", "default": "#111111" },
    { "type": "color", "id": "point_background", "label": "Point background", "default": "#172235" },
    { "type": "color", "id": "point_text_color", "label": "Point text", "default": "#FFFFFF" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Conversion boost panel" }],
  "tag": null,
  "class": "conversion-boost-panel"
}
{% endschema %}